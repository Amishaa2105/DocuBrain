local.file_match "docubrain_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/docubrain/docubrain.log",
      "job" = "docubrain",
      "service" = "docubrain",
    },
  ]
}

loki.source.file "docubrain" {
  targets    = local.file_match.docubrain_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
